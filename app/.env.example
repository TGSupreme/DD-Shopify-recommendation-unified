# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=Shopify-recommendation-unified

# Jina AI (Embedding Service)
JINA_API_KEY=your_jina_api_key_here
JINA_EMBEDDING_URL=https://api.jina.ai/v1/embeddings
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en

# Recommendation Weights
WEIGHT_VIEW=1.0
WEIGHT_CART=3.0
WEIGHT_PURCHASE=5.0

# Rate Limiting (Tenant-Only)
# Format: "count/period" (e.g., "300/minute", "20/minute")
RATE_LIMIT_STOREFRONT=300/minute
RATE_LIMIT_SYNC=20/minute

# System Configuration
VECTOR_DIMENSION=768
TOP_K=10

# admin api
ADMIN_API_KEY = "admin_secret_key" 